{
    "name": "local/cover-letter-maker",
    "description": "Rule-based cover letter generator with PDF export, built in plain PHP.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "dompdf/dompdf": "^3.0",
        "smalot/pdfparser": "^2.0",
        "phpoffice/phpword": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "CoverLetterMaker\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
